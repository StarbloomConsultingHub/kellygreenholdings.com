---
// Kelly Green Holdings — Home Page
// Parent company. Operator built. Patient capital.

import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kelly Green Holdings"
  description="Kelly Green Holdings builds enduring value by acquiring, operating, and scaling essential businesses with the insight of experienced operators and the discipline of patient capital. Based in Hagerstown, MD."
>

<!-- ═══ NAV ═══ -->
<nav class="fixed top-0 left-0 right-0 z-50 bg-ash-50/90 backdrop-blur-md border-b border-ash-200">
  <div class="container flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-3">
      <div class="w-10 h-10 bg-kelly-600 rounded-lg flex items-center justify-center text-white font-bold text-lg">K</div>
      <span class="font-semibold text-ash-900 text-lg">Kelly Green Holdings</span>
    </a>
    <div class="hidden md:flex items-center gap-8 text-sm font-medium text-ash-600">
      <a href="#about" class="hover:text-kelly-600 transition-colors">About</a>
      <a href="#portfolio" class="hover:text-kelly-600 transition-colors">Portfolio</a>
      <a href="#approach" class="hover:text-kelly-600 transition-colors">Approach</a>
      <a href="#contact" class="hover:text-kelly-600 transition-colors">Contact</a>
    </div>
  </div>
</nav>

<!-- ═══ HERO ═══ -->
<section class="min-h-screen flex items-center pt-16 bg-gradient-to-b from-ash-50 via-kelly-100/30 to-ash-50">
  <div class="container py-24 md:py-32">
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-kelly-600/10 rounded-full text-kelly-700 text-sm font-medium mb-8">
        <span class="w-2 h-2 rounded-full bg-kelly-500"></span>
        Operator Built &middot; Patient Capital
      </div>
      <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold text-ash-900 mb-6">
        Enduring Value.<br />
        <span class="gradient-text">Essential Businesses.</span>
      </h1>
      <p class="text-lg md:text-xl text-ash-600 leading-relaxed mb-10 max-w-2xl">
        Kelly Green Holdings builds enduring value by acquiring, operating, and scaling essential businesses with the insight of experienced operators and the discipline of patient capital.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#portfolio" class="px-6 py-3 bg-kelly-600 text-white rounded-lg font-semibold hover:bg-kelly-700 transition-colors shadow-sm">
          Our Portfolio
        </a>
        <a href="#approach" class="px-6 py-3 border border-ash-300 text-ash-700 rounded-lg font-semibold hover:border-kelly-400 hover:text-kelly-700 transition-colors">
          How We Operate
        </a>
      </div>
    </div>
  </div>
</section>

<!-- ═══ ABOUT ═══ -->
<section id="about" class="py-20 md:py-28 bg-ash-50">
  <div class="container">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-ash-900 mb-6">Who We Are</h2>
      <p class="text-lg text-ash-600 leading-relaxed mb-6">
        We are operators, not financiers. Every business we own is one we understand from the ground up because we have worked the ground. Kelly Green Holdings was founded on the belief that the best businesses are built by people who have actually done the work.
      </p>
      <p class="text-lg text-ash-600 leading-relaxed mb-6">
        Headquartered in Hagerstown, Maryland, we take a hands-on approach to every acquisition. We do not flip companies, strip assets, or chase trends. We acquire essential businesses with strong fundamentals, improve their operations, and grow them over the long haul.
      </p>
      <p class="text-lg text-ash-600 leading-relaxed">
        Our portfolio spans agriculture, operational services, and technology. Each company operates independently with its own brand and leadership, backed by the resources, network, and operational expertise of the holding company.
      </p>
    </div>
  </div>
</section>

<!-- ═══ PORTFOLIO ═══ -->
<section id="portfolio" class="py-20 md:py-28 bg-ash-100/50">
  <div class="container">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-ash-900 mb-4">Our Portfolio</h2>
      <p class="text-lg text-ash-600 max-w-2xl mx-auto">
        Independent brands united by operational excellence and a shared commitment to enduring value.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">

      <!-- Croos -->
      <div class="bg-white rounded-2xl p-8 border border-ash-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-kelly-600/10 rounded-xl flex items-center justify-center mb-5">
          <span class="text-kelly-700 font-bold text-xl">C</span>
        </div>
        <h3 class="text-xl font-bold text-ash-900 mb-2">Croos</h3>
        <p class="text-ash-600 text-sm font-medium mb-3">Crew Operations</p>
        <p class="text-ash-600 leading-relaxed mb-6 text-sm">
          Operational tools and systems for the people who actually run things. Spreadsheets, SOPs, and crew management solutions built by operators for operators.
        </p>
        <a href="#" class="text-kelly-600 font-medium text-sm hover:text-kelly-700 transition-colors inline-flex items-center gap-1">
          Learn more &rarr;
        </a>
      </div>

      <!-- Signal -->
      <div class="bg-white rounded-2xl p-8 border border-ash-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-kelly-600/10 rounded-xl flex items-center justify-center mb-5">
          <span class="text-kelly-700 font-bold text-xl">S</span>
        </div>
        <h3 class="text-xl font-bold text-ash-900 mb-2">Signal</h3>
        <p class="text-ash-600 text-sm font-medium mb-3">AEO Agency Services</p>
        <p class="text-ash-600 leading-relaxed mb-6 text-sm">
          White-label answer engine optimization for agencies. Data-driven authority building that helps businesses get found in an AI-first search world.
        </p>
        <a href="#" class="text-kelly-600 font-medium text-sm hover:text-kelly-700 transition-colors inline-flex items-center gap-1">
          Learn more &rarr;
        </a>
      </div>

      <!-- DataShield -->
      <div class="bg-white rounded-2xl p-8 border border-ash-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="w-12 h-12 bg-kelly-600/10 rounded-xl flex items-center justify-center mb-5">
          <span class="text-kelly-700 font-bold text-xl">D</span>
        </div>
        <h3 class="text-xl font-bold text-ash-900 mb-2">DataShield</h3>
        <p class="text-ash-600 text-sm font-medium mb-3">Privacy Protection</p>
        <p class="text-ash-600 leading-relaxed mb-6 text-sm">
          Data broker opt-out services for small businesses and individuals. Automated scanning and removal from the data broker ecosystem.
        </p>
        <a href="https://datashieldnow.com" target="_blank" rel="noopener noreferrer" class="text-kelly-600 font-medium text-sm hover:text-kelly-700 transition-colors inline-flex items-center gap-1">
          Visit Site &rarr;
        </a>
      </div>

    </div>
  </div>
</section>

<!-- ═══ APPROACH ═══ -->
<section id="approach" class="py-20 md:py-28 bg-ash-900 text-ash-100">
  <div class="container">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">The Kelly Green Approach</h2>
      <p class="text-lg text-ash-400 max-w-2xl mx-auto">
        We buy businesses we understand, run them better, and keep them for the long haul.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <div class="text-center p-6">
        <div class="w-16 h-16 bg-kelly-700/30 rounded-full flex items-center justify-center mx-auto mb-5">
          <span class="text-kelly-400 font-bold text-2xl">01</span>
        </div>
        <h3 class="text-xl font-bold mb-2">Acquire</h3>
        <p class="text-ash-400 text-sm leading-relaxed">
          We target essential businesses with proven fundamentals. No hype, no speculation. Real companies serving real needs.
        </p>
      </div>

      <div class="text-center p-6">
        <div class="w-16 h-16 bg-kelly-700/30 rounded-full flex items-center justify-center mx-auto mb-5">
          <span class="text-kelly-400 font-bold text-2xl">02</span>
        </div>
        <h3 class="text-xl font-bold mb-2">Operate</h3>
        <p class="text-ash-400 text-sm leading-relaxed">
          We improve operations from the inside. Our team has built and managed complex operations from scratch. We know what works.
        </p>
      </div>

      <div class="text-center p-6">
        <div class="w-16 h-16 bg-kelly-700/30 rounded-full flex items-center justify-center mx-auto mb-5">
          <span class="text-kelly-400 font-bold text-2xl">03</span>
        </div>
        <h3 class="text-xl font-bold mb-2">Scale</h3>
        <p class="text-ash-400 text-sm leading-relaxed">
          Patient growth over time. We reinvest, we optimize, and we grow sustainably. No exit strategy. We are building generational value.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- ═══ CONTACT ═══ -->
<section id="contact" class="py-20 md:py-28 bg-ash-50">
  <div class="container">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-ash-900 mb-4">Get In Touch</h2>
      <p class="text-lg text-ash-600 mb-3">
        Based in Hagerstown, Maryland. We are always looking to connect with operators who share our approach to building enduring businesses.
      </p>
      <a href="mailto:hello@kellygreenholdings.com" class="inline-flex items-center gap-2 text-kelly-600 font-semibold hover:text-kelly-700 transition-colors text-lg">
        hello@kellygreenholdings.com &rarr;
      </a>
    </div>
  </div>
</section>

<!-- ═══ FOOTER ═══ -->
<footer class="py-10 bg-ash-900 text-ash-500 text-sm">
  <div class="container text-center">
    <p>&copy; {new Date().getFullYear()} Kelly Green Holdings. All rights reserved.</p>
    <p class="mt-1">Hagerstown, Maryland</p>
  </div>
</footer>

</Layout>
